# Copy this file to .env and fill in what you need. paperclip runs FULLY with none of
# these set: no key means MOCK AI mode, and metadata lookups (CrossRef, arXiv) work with
# no key at all.

# --- AI (server-side only; never shipped to the browser) -------------------
# If unset, the server runs in MOCK MODE: collection analysis returns a realistic,
# structured result with no key needed.
ANTHROPIC_API_KEY=

# --- Optional: Semantic Scholar --------------------------------------------
# Not required. If set, a descriptive key raises Semantic Scholar rate limits for
# any future enrichment lookups. Metadata from CrossRef and arXiv needs no key.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: override the server port (default 3001)
PORT=3001
